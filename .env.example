# Admin token / 管理密码
ADMIN_TOKEN=change-me-to-a-secret

# Listen address / 监听地址
LISTEN_ADDR=:9800

# Data directory / 数据目录 (SQLite)
# DATA_DIR=./data

# Cloudflare Turnstile / CF验证 (sitekey,secret | 留空或 none 关闭)
# TURNSTILE_KEYS=0x4AAAAAAA...,0x4AAAAAAA...
TURNSTILE_KEYS=

# Trusted proxies / 可信反向代理 — 仅当请求来自这些地址时才信任
# CF-Connecting-IP / X-Real-IP 头 (防止伪造 IP 绕过限流)
# 可选值: 逗号分隔的 CIDR, 或关键字 private / cloudflare / * / none
# 默认 (留空): private,cloudflare
# TRUSTED_PROXIES=private,cloudflare
